{
  "manifest_version": 3,
  "name": "Vane-Helper",
  "version": "1.0",
  "description": "A collection of helper tools, including adding the current YouTube video to Notion.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://api.notion.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}